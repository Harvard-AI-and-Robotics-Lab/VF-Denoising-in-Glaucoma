+﻿import tensorflow as tf
+import numpy as np
+
+def dense(x, out_dim, gain=np.sqrt(2), name="dense"):
+    with tf.variable_scope(name):
+        in_dim = x.shape[-1].value
+        w = tf.get_variable(
+            "weight",
+            shape=[in_dim, out_dim],
+            initializer=tf.initializers.random_normal(0, gain / np.sqrt(in_dim)),
+        )
+        b = tf.get_variable("bias", shape=[out_dim], initializer=tf.initializers.zeros())
+        y = tf.matmul(x, tf.cast(w, x.dtype)) + tf.cast(b, x.dtype)
+        return y
+
+def autoencoder(x, width=256, height=256, **_kwargs):
+    """
+    Vector denoiser for VF TD:
+      input:  [B, 52]
+      output: [B, 52]
+    Keeps the same function name ("autoencoder") so config.net_config doesn't change.
+    """
+    x = tf.cast(x, tf.float32)
+    x.set_shape([None, 52])
+
+    n = x
+    n = tf.nn.leaky_relu(dense(n, 256, name="fc1"), alpha=0.1)
+    n = tf.nn.leaky_relu(dense(n, 256, name="fc2"), alpha=0.1)
+    n = tf.nn.leaky_relu(dense(n, 128, name="fc3"), alpha=0.1)
+    n = tf.nn.leaky_relu(dense(n, 128, name="fc4"), alpha=0.1)
+
+    # output layer (no activation)
+    out = dense(n, 52, gain=1.0, name="fc_out")
+    return out
+
+
 
